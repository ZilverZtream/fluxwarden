{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZilverZtream/fluxwarden/schemas/output/nodes-list.schema.json",
  "title": "fluxwarden nodes list --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "command", "ok", "warnings", "result", "error"],
  "properties": {
    "schema": { "const": 1 },
    "command": { "const": "nodes list" },
    "ok": { "type": "boolean" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "result": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/result" }] },
    "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }] }
  },
  "oneOf": [
    { "properties": { "ok": { "const": true }, "result": { "$ref": "#/$defs/result" }, "error": { "type": "null" } } },
    { "properties": { "ok": { "const": false }, "result": { "type": "null" }, "error": { "$ref": "#/$defs/error" } } }
  ],
  "$defs": {
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["CHANNEL_READ", "PAYMENT_READ", "PAYMENT_TRACK", "INVOICE_CREATE", "INVOICE_CANCEL", "FORWARDING_READ", "BOOKKEEPER_READ", "EXPLICIT_ROUTE_CONTROL", "ASKRENE_LAYER_ROUTING"]
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "step", "message"],
      "properties": {
        "code": { "type": "integer", "minimum": 1, "maximum": 9 },
        "step": { "type": ["string", "null"] },
        "message": { "type": "string" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "implementation", "expected_pubkey", "expected_network", "state", "observed_version", "capabilities", "last_probed_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "implementation": { "enum": ["lnd", "cln"] },
        "expected_pubkey": { "type": "string", "pattern": "^0[23][0-9a-f]{64}$" },
        "expected_network": { "const": "regtest" },
        "state": { "enum": ["ONLINE", "OFFLINE", "QUARANTINED"] },
        "observed_version": { "type": ["string", "null"] },
        "capabilities": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/capabilities" }] },
        "last_probed_at": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$" }
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes"],
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    }
  }
}
