{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZilverZtream/fluxwarden/schemas/output/actions-execute.json",
  "title": "fluxwarden actions execute --json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "ok",
    "warnings",
    "result",
    "error"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "command": {
      "const": "actions execute"
    },
    "ok": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/result"
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "ok": {
          "const": true
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "error": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "ok": {
          "const": false
        },
        "result": {
          "type": "null"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    }
  ],
  "$defs": {
    "msat": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "signedMsat": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "step",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "proposal_id",
        "status",
        "principal_msat",
        "actual_fee_msat",
        "fee_ppm",
        "cltv_delta",
        "source_delta_msat",
        "target_delta_msat",
        "delta_status",
        "journal_ids"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_id": {
          "type": "string",
          "pattern": "^prop_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "status": {
          "const": "VERIFIED_SUCCESS"
        },
        "principal_msat": {
          "$ref": "#/$defs/msat"
        },
        "actual_fee_msat": {
          "anyOf": [
            { "$ref": "#/$defs/msat" },
            { "type": "null" }
          ]
        },
        "fee_ppm": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cltv_delta": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 2016
        },
        "source_delta_msat": {
          "anyOf": [
            { "$ref": "#/$defs/signedMsat" },
            { "type": "null" }
          ]
        },
        "target_delta_msat": {
          "anyOf": [
            { "$ref": "#/$defs/signedMsat" },
            { "type": "null" }
          ]
        },
        "delta_status": {
          "enum": [
            "MATCH",
            "MISMATCH",
            "PENDING"
          ]
        },
        "journal_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "delta_status": { "enum": ["MATCH", "MISMATCH"] } },
            "required": ["delta_status"]
          },
          "then": {
            "properties": {
              "source_delta_msat": { "$ref": "#/$defs/signedMsat" },
              "target_delta_msat": { "$ref": "#/$defs/signedMsat" }
            }
          }
        }
      ]
    }
  }
}
