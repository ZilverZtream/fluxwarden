{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZilverZtream/fluxwarden/schemas/output/ledger-verify.json",
  "title": "fluxwarden ledger verify --json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "ok",
    "warnings",
    "result",
    "error"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "command": {
      "const": "ledger verify"
    },
    "ok": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/result"
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "ok": {
          "const": true
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "error": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "ok": {
          "const": false
        },
        "result": {
          "type": "null"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    }
  ],
  "$defs": {
    "msat": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "signedMsat": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "step",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journals",
        "steps"
      ],
      "properties": {
        "journals": {
          "type": "integer",
          "minimum": 0
        },
        "steps": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "stepResult": {
      "enum": [
        "compared",
        "pending",
        "not-requested",
        "unavailable",
        "incomplete"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "result"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "result": {
          "$ref": "#/$defs/stepResult"
        }
      }
    }
  }
}
