{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZilverZtream/fluxwarden/schemas/output/channels.schema.json",
  "title": "fluxwarden channels --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "command", "ok", "warnings", "result", "error"],
  "properties": {
    "schema": { "const": 1 },
    "command": { "const": "channels" },
    "ok": { "type": "boolean" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "result": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/result" }] },
    "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }] }
  },
  "oneOf": [
    { "properties": { "ok": { "const": true }, "result": { "$ref": "#/$defs/result" }, "error": { "type": "null" } } },
    { "properties": { "ok": { "const": false }, "result": { "type": "null" }, "error": { "$ref": "#/$defs/error" } } }
  ],
  "$defs": {
    "msat": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "nullableMsat": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/msat" }] },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "step", "message"],
      "properties": {
        "code": { "type": "integer", "minimum": 1, "maximum": 9 },
        "step": { "type": ["string", "null"] },
        "message": { "type": "string" }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel", "peer", "state", "capacity_msat", "spendable_msat", "receivable_msat", "confidence", "caveat",
        "pending_in_msat", "pending_out_msat", "inbound_target_msat", "inbound_deficit_msat", "outbound_target_msat",
        "outbound_deficit_msat", "observed_at", "snapshot_age_ms"
      ],
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "peer": { "type": "string", "pattern": "^0[23][0-9a-f]{64}$" },
        "state": { "enum": ["ACTIVE", "INACTIVE", "PENDING", "CLOSING", "UNKNOWN"] },
        "capacity_msat": { "$ref": "#/$defs/msat" },
        "spendable_msat": { "$ref": "#/$defs/msat" },
        "receivable_msat": { "$ref": "#/$defs/msat" },
        "confidence": { "enum": ["NODE_REPORTED", "DERIVED_ESTIMATE"] },
        "caveat": { "type": ["string", "null"] },
        "pending_in_msat": { "$ref": "#/$defs/msat" },
        "pending_out_msat": { "$ref": "#/$defs/msat" },
        "inbound_target_msat": { "$ref": "#/$defs/nullableMsat" },
        "inbound_deficit_msat": { "$ref": "#/$defs/msat" },
        "outbound_target_msat": { "$ref": "#/$defs/nullableMsat" },
        "outbound_deficit_msat": { "$ref": "#/$defs/msat" },
        "observed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$" },
        "snapshot_age_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "implementation", "channels"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "implementation": { "enum": ["lnd", "cln"] },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sort", "nodes"],
      "properties": {
        "sort": { "enum": [null, "inbound-deficit", "outbound", "capacity"] },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    }
  }
}
