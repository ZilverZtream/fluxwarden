{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZilverZtream/fluxwarden/schemas/output/liquidity-approve.json",
  "title": "fluxwarden liquidity approve --json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "ok",
    "warnings",
    "result",
    "error"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "command": {
      "const": "liquidity approve"
    },
    "ok": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/result"
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "ok": {
          "const": true
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "error": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "ok": {
          "const": false
        },
        "result": {
          "type": "null"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    }
  ],
  "$defs": {
    "msat": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "signedMsat": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "step",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "proposal_id",
        "key_id",
        "max_fee_msat",
        "max_cltv_delta",
        "expires_at"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_id": {
          "type": "string",
          "pattern": "^prop_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "max_fee_msat": {
          "$ref": "#/$defs/msat"
        },
        "max_cltv_delta": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2016
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
