{
  "name": "fluxwarden",
  "version": "1.0.0",
  "description": "Policy-bound liquidity controller for LND and Core Lightning.",
  "homepage": "https://github.com/ZilverZtream/fluxwarden#readme",
  "bugs": {
    "url": "https://github.com/ZilverZtream/fluxwarden/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZilverZtream/fluxwarden.git"
  },
  "type": "module",
  "bin": {
    "fluxwarden": "dist/cli/bin.js"
  },
  "files": [
    "dist/",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.23.2 || ^24.18.1 || >=26.5.1"
  },
  "license": "MIT",
  "scripts": {
    "pretest": "npm run build",
    "test": "vitest run --project product",
    "test:harness": "vitest run --project harness-docs",
    "test:related": "vitest related --run",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.json && node scripts/build-info.mjs",
    "prepack": "node scripts/prepack.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "test:lab": "vitest run --config vitest.lab.config.ts",
    "test:chaos": "vitest run --config vitest.chaos.config.ts",
    "test:full": "node scripts/later.mjs",
    "lab:up": "node labs/docker/lab.mjs up",
    "lab:down": "node labs/docker/lab.mjs down",
    "fixtures:record": "node scripts/make-fixtures.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vite": "8.3.2",
    "eslint": "10.11.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.0",
    "@types/node": "22.20.5",
    "globals": "17.13.0",
    "ajv": "8.20.0"
  }
}
