{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "authorized", "disposable", "network", "staticRoot", "sourceManifest", "bindingSourceManifest", "budget", "owners"],
  "properties": {
    "version": {"const": 2}, "authorized": {"const": true}, "disposable": {"const": true}, "network": {"const": "regtest"},
    "staticRoot": {"type": "string", "minLength": 1}, "sourceManifest": {"type": "string", "minLength": 1},
    "bindingSourceManifest": {"type": "string", "minLength": 1},
    "budget": {"type": "object", "additionalProperties": false, "required": ["cpus", "memoryBytes", "pids", "workers"],
      "properties": {"cpus": {"type": "number", "exclusiveMinimum": 0, "maximum": 8},
        "memoryBytes": {"type": "integer", "minimum": 1, "maximum": 8589934592},
        "pids": {"type": "integer", "minimum": 1, "maximum": 2048}, "workers": {"const": 2}}},
    "owners": {"type": "array", "minItems": 2, "maxItems": 2, "items": {
      "type": "object", "additionalProperties": false, "required": ["declaration", "imagePins", "endpointRefs", "changePassword"],
      "properties": {"declaration": {"type": "string", "minLength": 1},
        "imagePins": {"type": "object", "minProperties": 7, "maxProperties": 7, "additionalProperties": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"}},
        "endpointRefs": {"type": "object", "additionalProperties": false, "required": ["lnd-p", "lnd-r", "cln-p", "cln-r", "cln-m"],
          "properties": {"lnd-p": {"$ref": "#/$defs/ref"}, "lnd-r": {"$ref": "#/$defs/ref"}, "cln-p": {"$ref": "#/$defs/ref"}, "cln-r": {"$ref": "#/$defs/ref"}, "cln-m": {"$ref": "#/$defs/ref"}}},
        "changePassword": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "fresh-denial-control"}}}
      }
    }}
  },
  "$defs": {"ref": {"type": "object", "additionalProperties": false, "required": ["node", "transport", "certificate", "roles"],
    "properties": {"node": {"enum": ["lnd-p", "lnd-r", "cln-p", "cln-r", "cln-m"]}, "transport": {"const": "owned-node-https"},
      "certificate": {"type": "object", "additionalProperties": false, "required": ["node"], "properties": {"node": {"enum": ["lnd-p", "lnd-r", "cln-p", "cln-r", "cln-m"]}}},
      "roles": {"const": ["read", "execute"]}}}}
}
