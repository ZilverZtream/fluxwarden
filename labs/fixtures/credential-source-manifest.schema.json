{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "profile", "repositories", "sources", "aliases"],
  "properties": {
    "version": {"const": 2},
    "profile": {"enum": ["credential-primary-v1", "credential-wire-v1"]},
    "repositories": {"type": "array", "minItems": 2, "maxItems": 2, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "url", "revision", "commit", "gitRoot"],
      "properties": {"id": {"enum": ["lnd", "cln"]}, "url": {"type": "string"}, "revision": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "gitRoot": {"type": "string", "minLength": 1}}
    }},
    "sources": {"type": "array", "minItems": 13, "maxItems": 31, "items": {
      "type": "object", "additionalProperties": false, "required": ["repository", "path", "file", "sha256"],
      "properties": {"repository": {"enum": ["lnd", "cln"]}, "path": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    }},
    "aliases": {"type": "array", "maxItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["repository", "method", "schema"],
      "properties": {"repository": {"const": "cln"}, "method": {"const": "invokerune"}, "schema": {"const": "doc/schemas/createrune.json"}}
    }}
  }
}
